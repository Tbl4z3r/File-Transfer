  },
  "dependencies": {
    "@tauri-apps/api": "2.12.5",
    "qrcode-generator": "2.0.4"
  },
  "devDependencies": {
    "@tauri-apps/cli": "2.12.5",
    "typescript": "6.0.3"
  }
}
